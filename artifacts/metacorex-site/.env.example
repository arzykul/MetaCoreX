# Env vars for @workspace/metacorex-site.
#
# On Replit, none of these need to be set — the shared proxy puts the site
# and the API on the same origin, and artifact.toml already provides
# BASE_PATH. They matter for a split deployment (e.g. Render Static Site +
# a separate Render Web Service for the API) — see docs/deploy-render.md.

# Required at build time. Base path the app is served under.
# Render (site at its own domain root): BASE_PATH=/
# Replit dev (shared proxy path prefix): BASE_PATH=/metacorex-site/
BASE_PATH=/

# Optional. Full origin of the API server for a split deployment. Leave
# unset for same-origin deploys (Replit, or serving both from one host) —
# requests then stay relative ("/api/...") instead of absolute.
# Example: VITE_API_URL=https://metacorex-backend.onrender.com
VITE_API_URL=

# Optional. WalletConnect Cloud project ID, only needed if you want
# WalletConnect as a wagmi connector option.
VITE_WALLETCONNECT_PROJECT_ID=

# Optional. Endpoint the contact page's form submits to (e.g. a Formspree
# or similar hosted form endpoint). Leave unset to disable the contact form.
VITE_CONTACT_FORM_ENDPOINT=
